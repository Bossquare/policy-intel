    {
      "id": "2026-09-022",
      "no": 4,
      "title": "关于进一步加强智能建造技术应用的通知",
      "org": "南京市建委",
      "date": "2026-09-02",
      "date_raw": "09-02印发",
      "level": "key-city",
      "level_label": "重点省市",
      "region": "南京",
      "form": "规范性文件",
      "summary": "2万㎡以上项目强制嵌入；给费用、给用工；机器人培训上岗。",
      "source": {
        "label": "sjw.nanjing.gov.cn",
        "url": "http://sjw.nanjing.gov.cn/tzgg/202609/t20260902_5904391.html",
        "status": "ok",
        "checked_at": null
      },
      "confidence": "高",
      "tracks": [
        "intelligent-construction"
      ],
      "tier": "focus",
      "tier_label": "重点关注",
      "relevance": 83,
      "impact": "把「2 万㎡ 以上政府投资项目必须明确智能建造要求」写成硬门槛，并配套「补充定额足额编列费用 + 机器人操作人员培训上岗」，是从「给名单」到「给门槛、给钱、给人」的完整闭环。南京是全国首批智能建造试点城市，做法具备强示范效应，大概率被其他试点城市复制。",
      "action": "① 重点研究江苏省智能建造补充定额的费用构成，明确公司哪些产品/服务能被定额覆盖（这直接决定可报价空间）；② 针对招标文件中「明确智能建造要求」的条款，提前准备技术方案模板；③ 评估是否切入机器人操作人员培训与认证业务。"
    },
