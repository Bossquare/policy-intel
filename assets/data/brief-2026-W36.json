    {
      "id": "2026-09-011",
      "no": 6,
      "title": "上海住建管理\"十五五\"规划（沪建综规〔2026〕362号）",
      "org": "上海市住建管理委",
      "date": "2026-09-03",
      "date_raw": "09-03公开",
      "level": "key-city",
      "level_label": "重点省市",
      "region": "上海",
      "form": "五年规划",
      "summary": "120个智能建造项目；600万㎡建筑机器人；装配式≥90%；三星绿建20%。",
      "source": {
        "label": "zjw.sh.gov.cn",
        "url": "https://zjw.sh.gov.cn/jsgl/20260902/652ccdc1039e4514a90e02c0e1e0bc98.html",
        "status": "ok",
        "checked_at": null
      },
      "confidence": "高",
      "tracks": [
        "intelligent-construction"
      ],
      "tier": "focus",
      "tier_label": "重点关注",
      "relevance": 83,
      "impact": "上海给出长三角最明确的量化牵引：到 2030 年累计 120 个智能建造项目、建筑机器人应用不少于 600 万㎡、装配式占比 ≥90%、三星级绿建占比 20%。这是可倒推市场规模的硬指标，且上海作为风向标城市，指标会被长三角其他城市参照。",
      "action": "① 按 600 万㎡ 建筑机器人应用倒推逐年市场规模，重排上海及长三角的资源投放节奏；② 梳理公司产品与「危、繁、脏、重」四类机器人应用场景的匹配度，明确主攻场景；③ 跟踪 120 个智能建造项目的批次名单，提前做客户触达与方案预埋。"
    },
